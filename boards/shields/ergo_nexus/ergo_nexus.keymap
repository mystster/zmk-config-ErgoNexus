#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30    // default: 10

#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
/ {
    behaviors {
        encoder_wheel: encoder_wheel {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C>, <&kp R >;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            bindings = <
&kp A    &kp Q    &kp W    &kp E    &kp R    &kp T          &kp A    &kp A    &kp A    &kp A    &kp A    &kp A
&kp A    &kp A    &kp A    &kp A    &kp A    &kp A          &kp A    &kp A    &kp A    &kp A    &kp A    &kp A
&kp A    &kp A    &kp A    &kp A    &kp A    &kp A          &kp A    &kp A    &kp A    &kp A    &kp A    &kp A
                  &kp A    &kp A    &kp A    &kp A          &kp A    &kp A    &kp A    &kp A
            >;
            sensor-bindings = <&encoder_wheel>;
        };
    };
 };

