#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30    // default: 10

#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include "behaviors.dtsi"
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/bt.h>
/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            display-name = "Base";
            bindings = <
&kp ESC    &kp Q    &kp W    &kp E    &kp R    &kp T          &kp Y    &kp U    &kp I     &kp O    &kp P    &bspc_del
&kp TAB     &hm LGUI A     &hm LALT S     &hm LCTRL D     &hm LSHIFT F     &kp G           &kp H     &hm RSHIFT J     &hm RCTRL K      &hm RALT L    &hm_semi RGUI 0    &sqt_morph
&kp A    &kp Z    &kp X    &kp C    &kp V    &kp B            &kp N    &kp M    &comma_morph    &dot_morph    &slash_morph    &bslh_morph
&kp A    &kp A    &kp A    &hm LCTRL INT5  &lt 1 SPACE  &kp LGUI       &bspc_del &lt 2 ENTER   &hm RCTRL INT4    &kp A    &kp A   &kp A
            >;
            sensor-bindings = <
                &inc_dec_kp UP DOWN
                &inc_dec_kp LEFT RIGHT
                &inc_dec_kp UP DOWN
                &inc_dec_kp LEFT RIGHT
            >;
        };
        number_layer { // Layer 1
            display-name = "number";
            bindings = <
&kp US_TILDE &kp US_EXCL  &kp US_AT    &kp US_HASH  &kp US_DLLR  &kp US_PRCNT       &kp US_CARET &kp US_AMPS  &kp US_LPAR  &kp US_RPAR  &kp US_ASTRK &trans
&trans    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5          &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &trans
&trans    &trans    &trans    &trans    &trans    &trans          &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans          &trans    &mo 3    &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <
                &inc_dec_kp UP DOWN
                &inc_dec_kp LEFT RIGHT
                &inc_dec_kp UP DOWN
                &inc_dec_kp LEFT RIGHT
            >;
        };
        cursor_layer { // Layer 2
            display-name = "cursor";
            bindings = <
&trans    &trans    &trans    &trans    &trans    &trans          &trans    &trans    &trans    &trans    &trans    &trans
&trans    &kp US_MINUS &kp US_PLUS  &kp US_EQUAL &kp US_LBRC  &kp US_RBRC        &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp US_PIPE  &kp US_GRAVE
&trans    &kp US_GRAVE &trans    &kp US_PIPE  &kp US_LBKT  &kp US_RBKT        &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans    &trans
&trans    &trans    &trans    &trans    &mo 3       &trans       &trans    &trans    &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <
                &inc_dec_kp UP DOWN
                &inc_dec_kp LEFT RIGHT
                &inc_dec_kp UP DOWN
                &inc_dec_kp LEFT RIGHT
            >;
        };
        function_layer { // Layer 3
            display-name = "function";
            bindings = <
&trans    &trans    &trans    &trans    &trans    &trans          &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6
&trans    &trans    &trans    &trans    &trans    &trans          &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&trans    &trans    &trans    &trans    &trans    &trans          &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans          &trans    &trans    &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <
                &inc_dec_kp LEFT RIGHT
                &inc_dec_kp UP DOWN
                &inc_dec_kp LEFT RIGHT
                &inc_dec_kp UP DOWN
            >;
        };
        special_layer { // Layer 4
            display-name = "special";
            bindings = <
&trans    &trans    &trans    &trans    &trans    &trans          &trans    &trans    &trans    &trans    &trans    &trans
&trans    &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &trans    &trans          &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans          &trans    &trans    &trans    &trans    &trans    &trans
&trans    &trans    &trans    &trans    &trans    &trans          &trans    &trans    &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <
                &inc_dec_kp LEFT RIGHT
                &inc_dec_kp UP DOWN
                &inc_dec_kp LEFT RIGHT
                &inc_dec_kp UP DOWN
            >;
        };
    };
 };

