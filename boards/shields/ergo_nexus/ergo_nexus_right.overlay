#include "ergo_nexus.dtsi"

&kscan0 {
    row-gpios
        = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio1 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
	col-gpios
	    = <&gpio0 31 (GPIO_ACTIVE_HIGH)>
		, <&gpio0 29 (GPIO_ACTIVE_HIGH)>
		, <&gpio0 2 (GPIO_ACTIVE_HIGH)>
		, <&gpio1 15 (GPIO_ACTIVE_HIGH)>
		, <&gpio1 13 (GPIO_ACTIVE_HIGH)>
		, <&gpio1 11 (GPIO_ACTIVE_HIGH)>
		;
};
&default_transform {
	col-offset = <6>;
}
&rotary_encoder_R_0 {
        a-gpios = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		status = "okay";
};
&rotary_encoder_R_1 {
        a-gpios = <&gpio1 00 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		status = "okay";
};
