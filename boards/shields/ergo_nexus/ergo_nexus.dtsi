#include <dt-bindings/zmk/matrix_transform.h> // Put this with the other includes at the top of your dtsi

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
        // Other chosen items
    };
	
    physical_layout0: physical_layout_0 { // First physical layout, use different naming for other layouts
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>; // Label of the kscan node, optional if all layouts use the same
        transform = <&default_transform>; // Label of the matrix transform for this layout
    };
	
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
 // | K_L_16 | K_L_15 | K_L_14 | K_L_13 | K_L_12 | K_L_11 |   | K_R_11 | K_R_12 | K_R_13 | K_R_14 | K_R_15 | K_R_16 |
 // | K_L_26 | K_L_25 | K_L_24 | K_L_23 | K_L_22 | K_L_21 |   | K_R_21 | K_R_22 | K_R_23 | K_R_24 | K_R_25 | K_R_26 |
 // | K_L_36 | K_L_35 | K_L_34 | K_L_33 | K_L_32 | K_L_31 |   | K_R_31 | K_R_32 | K_R_33 | K_R_34 | K_R_35 | K_R_36 |
 // | K_L_46 | K_L_45 | K_L_44 | K_L_43 | K_L_42 | K_L_41 |   | K_R_41 | K_R_42 | K_R_43 | K_R_44 | K_R_45 | K_R_46 |
        map = <
RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)     RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)     RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(4,11)
        >;
    };
	
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
    };
    rotary_encoder_L_0: encoderL0 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
    };
    rotary_encoder_L_1: encoderL1 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
    };
    rotary_encoder_R_0: encoderR0 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
    };
    rotary_encoder_R_1: encoderR1 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
    };
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&rotary_encoder_L_0 &rotary_encoder_L_1 &rotary_encoder_R_0 &rotary_encoder_R_1>;
        triggers-per-rotation = <8>;
    };
};
